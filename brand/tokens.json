{
  "$description": "Soap Bros design tokens. Source of truth for colour, type, shape and motion. Mirrors tokens.css.",
  "color": {
    "light": {
      "ground":  { "value": "#F1EDE3", "role": "page background" },
      "paper":   { "value": "#FBF8F1", "role": "panels, cards, table surfaces" },
      "ink":     { "value": "#141210", "role": "text, outlines, shadows" },
      "muted":   { "value": "#5F584D", "role": "secondary text" },
      "duck":    { "value": "#F7C21A", "role": "fill for the main action; never text on paper" },
      "beak":    { "value": "#F08A1C", "role": "second accent, small highlights" },
      "bubble":  { "value": "#5EC3EF", "role": "focus ring, decorative bubbles" },
      "foam":    { "value": "#CFEEFB", "role": "quiet highlight panel" },
      "link":    { "value": "#0B6C96", "role": "links on paper" },
      "ok":      { "value": "#23703C", "role": "success text" },
      "warn":    { "value": "#A85A06", "role": "warning text" },
      "no":      { "value": "#B3402E", "role": "error text" }
    },
    "dark": {
      "ground":  { "value": "#12161D" },
      "paper":   { "value": "#1A2029" },
      "ink":     { "value": "#ECE7DA" },
      "muted":   { "value": "#A2ABBA" },
      "duck":    { "value": "#F7C21A" },
      "beak":    { "value": "#F08A1C" },
      "bubble":  { "value": "#5EC3EF" },
      "foam":    { "value": "#1C3A4B" },
      "link":    { "value": "#5EC3EF" },
      "ok":      { "value": "#5FCF85" },
      "warn":    { "value": "#F08A1C" },
      "no":      { "value": "#F08A7A" },
      "line":    { "value": "#8E99AE", "role": "outlines in dark mode" },
      "shadow":  { "value": "#05070A" }
    },
    "on-duck": { "value": "#141210", "role": "text on duck, beak or bubble fills" },
    "tool-logo": { "value": "#6B778C", "role": "single mid-tone for third-party tool marks" },
    "cloud": {
      "azure":   { "value": "#2F7FD6" },
      "aws":     { "value": "#E08A1E" },
      "gcp":     { "value": "#2F9E5B" },
      "stackit": { "value": "#8A63D2" },
      "huawei":  { "value": "#C8102E" },
      "sakura":  { "value": "#E86AA6" },
      "other":   { "value": "#8C9099", "role": "cloud colours label clouds only, never status" }
    }
  },
  "font": {
    "display": { "value": "Silkscreen", "fallback": "Courier New, monospace", "weights": [400, 700], "use": "headings, wordmark, table headers" },
    "arcade":  { "value": "Press Start 2P", "fallback": "Courier New, monospace", "weights": [400], "use": "tiny labels, buttons, badges; 9 to 12 px only" },
    "body":    { "value": "IBM Plex Mono", "fallback": "ui-monospace, SF Mono, Menlo, monospace", "weights": [400, 500, 600], "use": "all running text and data" },
    "google-fonts-url": "https://fonts.googleapis.com/css2?family=Silkscreen:wght@400;700&family=Press+Start+2P&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
  },
  "shape": {
    "radius": { "value": "0" },
    "border": { "value": "3px solid ink", "heavy": "4px" },
    "shadow": { "value": "4px 4px 0 shadow-colour", "large": "8px 8px 0", "blur": "none, ever" }
  },
  "motion": {
    "easing": { "value": "steps(2)", "note": "stepped, never eased" },
    "duration": { "value": "80ms", "note": "hover and press" },
    "hover": "translate(-2px, -2px) and grow the shadow",
    "press": "translate(4px, 4px) and drop the shadow",
    "reduced-motion": "all animation off"
  },
  "space": { "unit": "4px", "scale": [4, 8, 12, 16, 24, 32, 48, 64] }
}
